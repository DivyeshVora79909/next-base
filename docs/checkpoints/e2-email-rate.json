  "obligations": [
    "Original receipt recovery before grant validity/expiry; normalized intent hash excludes bearer evidence.",
    "Source Create plus current explicit Use and final staged credential validation; hidden platform binding needs no Credential Read.",
    "Exact incarnation and accepted secret revision; label/rotation semantics, deletion guard, shared byte accounting and retained rewrap.",
    "Both-owner transfers and atomic owner/index/cursor/source/effect/receipt publication; no source population counter.",
    "Literal rolling point count preserves timestamp multiplicity; exact expiry/regression/bounds; immutable policy and reset protection.",
    "Committed physical starts only; denial persists wake without consuming attempts; at most three charged submissions.",
    "Only current-submit NotAccepted permits retry; missing or nonacceptance lookup never permits resend.",
    "Every actual new enqueue and admission/start write rolled back individually; original unknown ACK recovery and actual FDB full-slot/revocation races.",
    "Independent fake Resend and Brevo HTTP encoders/journals check exact expected email, key and account; no HTTP client retries.",
    "Missing keys stop owned work before provider calls; repaired keys reconcile original charged work.",
    "Backup/restore preserves exact retained ciphertext and quota tables, quarantines delivery, and permits read-only reconciliation.",
    "Public plan/receipt/status/observation checks exclude test provider plaintext and opaque grants; email status excludes hidden account.",
    "Original effect-demo, managed lifetime/fanout, owner authorization, native source-derived checks and Node release/provenance checks remain green."
  ],
  "limits": [
    "Local correctness, not live provider behavior, distributed throughput or universal quota guarantees.",
    "Quota domain is one store; all principals/credential versions sharing an account share admission.",
    "16 immutable policies, limit1..64, window1..86400000ms, 1000ms dispatch age; 256 retained executions and768 starts.",
    "Eight-MiB bounded effect budget includes distinct retained envelopes; no retention compactor or policy reset.",
    "Standalone SurrealKV not rerun in this checkpoint.",
    "A0-A2, E3, E5 and committed-source release/bootstrap remain required and unaccepted.",
    "Optional password mode, C5, E4, frontend, live providers and TiKV remain deferred."
  ]
}
