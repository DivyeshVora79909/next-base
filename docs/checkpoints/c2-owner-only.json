{
  "format": "next-base-owner-only-1",
  "checkpoint": "C2.O",
  "status": "accepted bounded owner-only authorization and storage integration",
  "parentCommit": "f35811872c2f8e452243170dbd2529b3a3ca41a6",
  "codec": "native-slice-kv-12",
  "contract": {
    "recordAuthority": "one immutable owner; no stored reader",
    "readCreateUpdate": "active caller, same tenant, contract action and owner in self/strict descendants/direct group parents",
    "delete": "active caller, same tenant, Delete action and owner=self or strict descendant; direct group membership alone never authorizes delete",
    "tenantParents": "not ordinary resource scope; direct active tenant/group grant inheritance remains separate",
    "createOwner": "optional canonical UUID string, omitted defaults to actor; requested owner checked before identity/existence diagnostics; owner edits on Update unavailable",
    "rootSummary": "readable anchor record plus declared public root operation; full summary includes hidden contributors; no separate tree ACL",
    "members": "independent per-record projection; readable root does not disclose hidden contributor ID/body",
    "rootIdentity": "stable source UUID plus root slot; rotations only change structural head",
    "namespace": "same-tenant source/reference guards and tenant-isolated adapter namespace; no implicit tenant aggregate",
    "indexes": "owner_records keyed by (owner,contract,UUID); same-snapshot k-way merge of accessible owner streams; owner/contract query epochs",
    "removed": [
      "ModelRecord.reader",
      "Reference.reader",
      "choose_reader",
      "reader candidate discovery/provenance/repair",
      "reader_records",
      "reader_checks metric",
      "record scans/rewrites on authority graph changes"
    ],
    "retained": [
      "linked augmented AVL summaries and structural sizes",
      "source-derived independent checks",
      "typed references and final-graph rules",
      "private managed output provenance",
      "interval stabbing and causal scheduling",
      "atomic publication, receipts, rollback, CAS and protected storage reads",
      "no persistent population counter"
    ]
  },
